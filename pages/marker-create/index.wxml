<view class="page">
  <view class="section">
    <text class="section-title">标签</text>
    <view class="category-grid">
      <view
        wx:for="{{categories}}"
        wx:key="value"
        class="category-item {{item.selectedClass}}"
        data-category="{{item.value}}"
        bindtap="onCategoryTap"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">标题</text>
    <input class="title-input" value="{{form.title}}" maxlength="10" placeholder="可不填，最多10个字" bindinput="onTitleInput" />
  </view>

  <view class="section">
    <text class="section-title">描述</text>
    <textarea class="desc-input" value="{{form.description}}" maxlength="30" placeholder="可不填，最多30个字" bindinput="onDescriptionInput" />
  </view>

  <view class="section">
    <text class="section-title">实景图</text>
    <view class="image-grid">
      <view
        wx:for="{{images}}"
        wx:key="path"
        class="image-item"
      >
        <image class="image-preview" src="{{item.path}}" mode="aspectFill" />
        <view class="image-remove" data-index="{{index}}" bindtap="onRemoveImageTap">×</view>
      </view>
      <view wx:if="{{images.length < 5}}" class="image-add" bindtap="onChooseImagesTap">
        <text class="image-add-plus">+</text>
        <text class="image-add-text">上传</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">位置</text>
    <view class="location-card">
      <map
        class="preview-map"
        latitude="{{point.latitude}}"
        longitude="{{point.longitude}}"
        scale="17"
        markers="{{previewMarkers}}"
        enable-scroll="{{false}}"
        enable-zoom="{{false}}"
        enable-rotate="{{false}}"
        enable-overlooking="{{false}}"
        show-location="{{false}}"
      />
      <view class="location-text">
        <text class="location-name">{{point.name}}</text>
        <text class="location-address">{{point.address}}</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <button class="secondary-button" bindtap="onCancelTap">取消</button>
    <button class="primary-button" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="onSubmitTap">确认</button>
  </view>

  <canvas
    canvas-id="imageCompressCanvas"
    class="compress-canvas"
    style="width: {{compressCanvasWidth}}px; height: {{compressCanvasHeight}}px;"
  />
</view>
