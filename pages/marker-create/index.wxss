page {
  min-height: 100vh;
  background: #f6f7f9;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.section {
  margin-bottom: 28rpx;
}

.section-title {
  display: block;
  margin-bottom: 14rpx;
  color: #111827;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 700;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  border-radius: 8rpx;
  color: #4b5563;
  background: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.category-item.is-selected {
  color: #ffffff;
  background: #111827;
}

.title-input,
.desc-input {
  width: 100%;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #ffffff;
  color: #111827;
  font-size: 28rpx;
}

.title-input {
  height: 86rpx;
  padding: 0 22rpx;
}

.desc-input {
  height: 180rpx;
  padding: 22rpx;
  line-height: 38rpx;
}

.location-card {
  overflow: hidden;
  border-radius: 8rpx;
  background: #ffffff;
}

.preview-map {
  width: 100%;
  height: 360rpx;
}

.location-text {
  padding: 18rpx 22rpx 22rpx;
}

.location-name,
.location-address {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.location-name {
  color: #111827;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 700;
}

.location-address {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 32rpx;
}

.footer {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 42rpx;
}

.primary-button,
.secondary-button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.primary-button {
  color: #ffffff;
  background: #111827;
}

.secondary-button {
  color: #111827;
  background: #e5e7eb;
}
