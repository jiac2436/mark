page {
  height: 100vh;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f6f7f9;
}

.header {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 18rpx 28rpx 20rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.location-status {
  display: block;
  width: 100%;
  overflow: hidden;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 32rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.header-actions {
  display: flex;
  width: 100%;
  gap: 12rpx;
}

.icon-button,
.text-button,
.primary-button,
.secondary-button,
.danger-button,
.vote-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.icon-button {
  flex: 1;
  min-width: 0;
  color: #111827;
  background: #f3f4f6;
}

.primary-icon-button {
  color: #ffffff;
  background: #111827;
}

.category-scroll {
  flex-shrink: 0;
  height: 86rpx;
  background: #ffffff;
  border-top: 1rpx solid #edf0f3;
}

.category-list {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: max-content;
  min-width: 100%;
  height: 86rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.category-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 52rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  color: #4b5563;
  background: #f3f4f6;
  font-size: 26rpx;
  white-space: nowrap;
}

.category-chip.is-active {
  color: #ffffff;
  background: #111827;
}

.permission-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  background: #fff7ed;
  color: #9a3412;
  font-size: 24rpx;
  line-height: 32rpx;
  box-sizing: border-box;
}

.permission-strip text {
  flex: 1;
}

.text-button {
  flex-shrink: 0;
  min-height: 52rpx;
  padding: 0 18rpx;
  color: #ffffff;
  background: #c2410c;
  font-size: 24rpx;
}

.map-shell {
  position: relative;
  flex: 1;
  width: 100%;
  min-height: 360rpx;
}

.map {
  width: 100%;
  height: 100%;
}

.panel {
  flex-shrink: 0;
  padding: 22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e5e7eb;
  box-shadow: 0 -8rpx 22rpx rgba(15, 23, 42, 0.08);
  box-sizing: border-box;
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-title,
.detail-title {
  display: block;
  color: #111827;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 700;
}

.panel-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 32rpx;
}

.panel-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 22rpx;
}

.primary-button {
  min-width: 180rpx;
  color: #ffffff;
  background: #111827;
}

.primary-button.is-disabled {
  color: #9ca3af;
  background: #e5e7eb;
}

.secondary-button {
  min-width: 152rpx;
  color: #111827;
  background: #f3f4f6;
}

.secondary-button.compact {
  min-width: 112rpx;
}

.danger-button {
  min-width: 112rpx;
  color: #ffffff;
  background: #dc2626;
}

.form-section {
  margin-top: 20rpx;
}

.field-label {
  margin: 18rpx 0 10rpx;
  color: #374151;
  font-size: 24rpx;
  font-weight: 600;
}

.form-category-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.form-category {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  border-radius: 8rpx;
  color: #4b5563;
  background: #f3f4f6;
  font-size: 25rpx;
}

.form-category.is-selected {
  color: #ffffff;
  background: #111827;
}

.text-input,
.textarea-input {
  width: 100%;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #f9fafb;
  color: #111827;
  font-size: 26rpx;
}

.text-input {
  height: 72rpx;
  padding: 0 18rpx;
}

.textarea-input {
  height: 128rpx;
  padding: 18rpx;
  line-height: 34rpx;
}

.cluster-count {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 76rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  color: #111827;
  background: #f3f4f6;
  font-size: 24rpx;
}

.marker-list-scroll {
  width: 100%;
  max-height: 360rpx;
  margin-top: 18rpx;
}

.marker-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.marker-list-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border: 2rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
}

.marker-list-item.is-selected {
  border-color: #111827;
  background: #f9fafb;
}

.list-item-main {
  min-width: 0;
  flex: 1;
}

.list-item-arrow {
  flex-shrink: 0;
  color: #9ca3af;
  font-size: 42rpx;
  line-height: 42rpx;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.category-discovery {
  color: #065f46;
  background: #d1fae5;
}

.category-notice {
  color: #1d4ed8;
  background: #dbeafe;
}

.category-complaint {
  color: #991b1b;
  background: #fee2e2;
}

.category-help {
  color: #7c2d12;
  background: #ffedd5;
}

.mine-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #111827;
  font-size: 20rpx;
  font-weight: 700;
}

.card-title {
  display: block;
  margin-top: 14rpx;
  overflow: hidden;
  color: #111827;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-desc {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #6b7280;
  font-size: 23rpx;
  line-height: 30rpx;
  white-space: normal;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: auto;
  padding-top: 14rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.detail {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f3;
}

.detail-main {
  min-width: 0;
  flex: 1;
}

.detail-desc {
  display: block;
  margin-top: 8rpx;
  color: #4b5563;
  font-size: 25rpx;
  line-height: 34rpx;
}

.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 23rpx;
  line-height: 30rpx;
}

.detail-actions {
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
  max-width: 252rpx;
}

.vote-button {
  min-width: 76rpx;
  min-height: 56rpx;
  padding: 0 16rpx;
  color: #374151;
  background: #f3f4f6;
  font-size: 24rpx;
}

.vote-button.is-active {
  color: #ffffff;
  background: #111827;
}
