page {
  height: 100vh;
}

.page {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg-color);
}

.header {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx 32rpx 24rpx;
  background: rgba(248, 248, 240, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-sizing: border-box;
  z-index: 10;
  border-bottom: 2rpx solid var(--border-color-light);
}

.location-status {
  display: block;
  width: 100%;
  overflow: hidden;
  color: var(--text-color-secondary);
  font-size: 24rpx;
  line-height: 32rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-weight: 500;
}

.header-actions {
  display: flex;
  width: 100%;
  gap: 16rpx;
}

.icon-button,
.text-button,
.primary-button,
.secondary-button,
.danger-button,
.vote-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: 4rpx solid var(--border-color);
  box-shadow: 0 8rpx 0 0 var(--shadow-btn);
  transition: transform 0.1s ease, box-shadow 0.1s ease;
}

.icon-button {
  flex: 1;
  min-width: 0;
  color: var(--text-color-body);
  background: var(--bg-color-secondary);
}

.primary-icon-button {
  color: var(--text-color);
  background: var(--primary-color-bg);
}

.permission-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  flex-shrink: 0;
  padding: 20rpx 32rpx;
  background: var(--primary-color-bg);
  color: var(--text-color);
  font-size: 25rpx;
  line-height: 34rpx;
  box-sizing: border-box;
  border-bottom: 4rpx solid var(--border-color);
  z-index: 5;
}

.permission-strip text {
  flex: 1;
}

.text-button {
  flex-shrink: 0;
  min-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 50rpx;
  color: var(--text-color-body);
  background: var(--warning-color);
  font-size: 24rpx;
  box-shadow: 0 6rpx 0 0 var(--warning-color-active);
}

.map-shell {
  position: relative;
  flex: 1;
  width: 100%;
  min-height: 0;
}

.map {
  width: 100%;
  height: 100%;
}

.map-filter {
  position: absolute;
  top: 36rpx;
  left: 28rpx;
  display: flex;
  align-items: center;
}

.map-filter-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg-color);
  border: 4rpx solid var(--border-color);
  box-shadow: 0 8rpx 0 0 var(--shadow-btn);
  font-size: 38rpx;
  line-height: 72rpx;
  text-align: center;
  box-sizing: border-box;
  padding-top: 4rpx;
  padding-left: 2rpx;
  transition: transform 0.1s ease, box-shadow 0.1s ease;
}

.map-filter-icon:active, .map-filter-icon.btn-active {
  transform: translateY(6rpx) !important;
  box-shadow: 0 2rpx 0 0 var(--shadow-btn) !important;
}

.map-filter-list {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 0rpx;
  opacity: 0;
  pointer-events: none;
  flex-wrap: nowrap;
  white-space: nowrap;
  height: 84rpx;
  overflow-x: scroll;
  transition: max-width 0.35s cubic-bezier(0.25, 0.8, 0.25, 1), 
              opacity 0.25s ease,
              margin-left 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
  will-change: max-width, opacity;
  transform: translateZ(0);
}

.map-filter-list.is-expanded {
  max-width: 580rpx;
  opacity: 1;
  pointer-events: auto;
  margin-left: 12rpx;
}

.map-filter-list.is-collapsed-active {
  max-width: 180rpx;
  opacity: 1;
  pointer-events: auto;
  margin-left: 12rpx;
}

.map-filter-list.is-hidden {
  max-width: 0rpx;
  opacity: 0;
  pointer-events: none;
  margin-left: 0rpx;
}

/* 隐藏 scroll-view 滚动条 */
.map-filter-list ::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

.map-filter-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 84rpx;
  height: 60rpx;
  padding: 0 18rpx;
  padding-top: 2rpx; /* 微调芯片文字垂直居中 */
  border-radius: 50rpx;
  color: var(--text-color-body);
  background: var(--bg-color-content);
  border: 4rpx solid var(--border-color);
  box-shadow: 0 6rpx 0 0 var(--shadow-btn);
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
  line-height: 52rpx;
  text-align: center;
  transition: transform 0.2s ease, box-shadow 0.1s ease, opacity 0.25s ease;
  flex-shrink: 0; /* 防止在 flex 布局下被压缩变形 */
}

.map-filter-chip.is-chip-hidden {
  opacity: 0;
  pointer-events: none;
}

.map-filter-chip.is-selected {
  color: var(--text-color);
  background: var(--primary-color);
}

/* 各分类普通状态下的底色和字色 */
.map-filter-chip.category-chip-fishing {
  color: #1a6f8a;
  background: #d4f0f7;
}
.map-filter-chip.category-chip-discovery {
  color: #3b7a57;
  background: #d2edd9;
}
.map-filter-chip.category-chip-notice {
  color: #a05a2c;
  background: #fae4c3;
}
.map-filter-chip.category-chip-urgent {
  color: #bd3a3a;
  background: #fcd5d5;
}
.map-filter-chip.category-chip-lost_found {
  color: #63439e;
  background: #e9e3f7;
}
.map-filter-chip.category-chip-help {
  color: #cc6015;
  background: #ffe3d1;
}
.map-filter-chip.category-chip-kindness {
  color: #bd3a72;
  background: #fcd5e5;
}

/* 各分类选中状态下的加深色彩及 3D 立体感 */
.map-filter-chip.category-chip-fishing.is-selected {
  color: #ffffff;
  background: #1a6f8a;
  border-color: var(--border-color);
  box-shadow: 0 6rpx 0 0 #114c60;
}
.map-filter-chip.category-chip-discovery.is-selected {
  color: #ffffff;
  background: #3b7a57;
  border-color: var(--border-color);
  box-shadow: 0 6rpx 0 0 #28563c;
}
.map-filter-chip.category-chip-notice.is-selected {
  color: #ffffff;
  background: #a05a2c;
  border-color: var(--border-color);
  box-shadow: 0 6rpx 0 0 #7a421e;
}
.map-filter-chip.category-chip-urgent.is-selected {
  color: #ffffff;
  background: #bd3a3a;
  border-color: var(--border-color);
  box-shadow: 0 6rpx 0 0 #912727;
}
.map-filter-chip.category-chip-lost_found.is-selected {
  color: #ffffff;
  background: #63439e;
  border-color: var(--border-color);
  box-shadow: 0 6rpx 0 0 #4a3077;
}
.map-filter-chip.category-chip-help.is-selected {
  color: #ffffff;
  background: #cc6015;
  border-color: var(--border-color);
  box-shadow: 0 6rpx 0 0 #9e460b;
}
.map-filter-chip.category-chip-kindness.is-selected {
  color: #ffffff;
  background: #bd3a72;
  border-color: var(--border-color);
  box-shadow: 0 6rpx 0 0 #9c2759;
}

.chip-active {
  transform: translateY(4rpx) !important;
  box-shadow: 0 2rpx 0 0 var(--shadow-btn) !important;
}

/* 各分类按压下陷时的 shadow 贴合 */
.map-filter-chip.category-chip-fishing.chip-active {
  box-shadow: 0 2rpx 0 0 #114c60 !important;
}
.map-filter-chip.category-chip-discovery.chip-active {
  box-shadow: 0 2rpx 0 0 #28563c !important;
}
.map-filter-chip.category-chip-notice.chip-active {
  box-shadow: 0 2rpx 0 0 #7a421e !important;
}
.map-filter-chip.category-chip-urgent.chip-active {
  box-shadow: 0 2rpx 0 0 #912727 !important;
}
.map-filter-chip.category-chip-lost_found.chip-active {
  box-shadow: 0 2rpx 0 0 #4a3077 !important;
}
.map-filter-chip.category-chip-help.chip-active {
  box-shadow: 0 2rpx 0 0 #9e460b !important;
}
.map-filter-chip.category-chip-kindness.chip-active {
  box-shadow: 0 2rpx 0 0 #9c2759 !important;
}

.map-locate-button {
  position: absolute;
  top: 228rpx;
  left: 28rpx;
  right: auto !important;
  bottom: auto !important;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg-color);
  border: 4rpx solid var(--border-color);
  box-shadow: 0 8rpx 0 0 var(--shadow-btn);
  transition: transform 0.1s ease, box-shadow 0.1s ease;
  box-sizing: border-box;
}

.map-locate-button.is-above-collapsed-panel {
  bottom: auto !important;
}

.map-locate-button.is-above-cluster-panel {
  bottom: auto !important;
}

.map-locate-button:active, .map-locate-button.btn-active {
  transform: translateY(6rpx) !important;
  box-shadow: 0 2rpx 0 0 var(--shadow-btn) !important;
}

/* 动森手绘风格瞄准镜定位图标（雷达瞄准） */
.map-locate-radar {
  position: relative;
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 贯穿十字线-水平 */
.map-locate-radar::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 3rpx;
  background: var(--text-color);
  transform: translateY(-50%);
  z-index: 1;
}

/* 贯穿十字线-垂直 */
.map-locate-radar::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background: var(--text-color);
  transform: translateX(-50%);
  z-index: 1;
}

/* 中层遮罩圆环 */
.radar-outer-ring {
  position: absolute;
  width: 38rpx;
  height: 38rpx;
  border: 3rpx solid var(--text-color);
  border-radius: 50%;
  background: var(--bg-color); /* 遮挡内部十字线 */
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 内层浅绿光晕底盘 */
.radar-halo {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: rgba(25, 200, 185, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 中心薄荷绿实心圆点 */
.radar-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary-color);
  box-sizing: border-box;
}

.map-create-button {
  position: absolute;
  top: 132rpx;
  left: 28rpx;
  right: auto !important;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  color: var(--text-color);
  background: var(--bg-color);
  border: 4rpx solid var(--border-color);
  box-shadow: 0 8rpx 0 0 var(--shadow-btn);
  box-sizing: border-box;
  transition: transform 0.1s ease, box-shadow 0.1s ease;
}

/* 新增图标外侧浅绿光晕底盘 */
.create-icon-halo {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(25, 200, 185, 0.22);
  box-sizing: border-box;
}

/* 纤细精致加号 - 放大一倍并绝对居中，使其探出光晕外 */
.create-icon-plus {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 72rpx;
  line-height: 1;
  font-weight: 300;
  color: var(--text-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.map-create-button:active, .map-create-button.btn-active {
  transform: translateY(6rpx) !important;
  box-shadow: 0 2rpx 0 0 var(--shadow-btn) !important;
}

.map-guide-button {
  position: absolute;
  top: 324rpx;
  left: 28rpx;
  right: auto !important;
  bottom: auto !important;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg-color);
  border: 4rpx solid var(--border-color);
  box-shadow: 0 8rpx 0 0 var(--shadow-btn);
  box-sizing: border-box;
  transition: transform 0.1s ease, box-shadow 0.1s ease;
}

.map-guide-button:active, .map-guide-button.btn-active {
  transform: translateY(6rpx) !important;
  box-shadow: 0 2rpx 0 0 var(--shadow-btn) !important;
}

.guide-icon-text {
  color: var(--text-color);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-color-content);
  border-top: 4rpx solid var(--border-color);
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 -8rpx 24rpx rgba(114, 93, 66, 0.15);
  box-sizing: border-box;
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-title,
.detail-title {
  display: block;
  color: var(--text-color);
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.panel-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--text-color-secondary);
  font-size: 26rpx;
  line-height: 36rpx;
}

.primary-button {
  min-width: 200rpx;
  color: var(--text-color);
  background: var(--primary-color-bg);
  border: 4rpx solid var(--border-color);
  box-shadow: 0 8rpx 0 0 var(--shadow-btn);
}

.primary-button.is-disabled {
  color: var(--text-color-disabled);
  background: var(--bg-color-disabled);
  box-shadow: none;
  border-color: var(--border-color-light);
}

.secondary-button {
  min-width: 160rpx;
  color: var(--text-color-body);
  background: var(--bg-color);
  border: 4rpx solid var(--border-color);
  box-shadow: 0 8rpx 0 0 var(--shadow-btn);
}

.secondary-button.compact {
  min-width: 120rpx;
}

.danger-button {
  min-width: 120rpx;
  color: #ffffff;
  background: var(--error-color);
  border: 4rpx solid var(--border-color);
  box-shadow: 0 8rpx 0 0 var(--error-color-active);
}

.cluster-panel-drag-area {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 0 0 16rpx;
  box-sizing: border-box;
}

.drag-pill {
  width: 72rpx;
  height: 10rpx;
  background: #cbd5e1;
  border-radius: 999rpx;
  margin: 12rpx 0 8rpx;
}

.cluster-panel-body {
  overflow: hidden;
  transition: max-height 250ms cubic-bezier(0.4, 0, 0.2, 1), opacity 200ms ease, transform 250ms cubic-bezier(0.4, 0, 0.2, 1), margin-top 250ms ease;
}

.cluster-panel-body.is-expanded {
  max-height: 800rpx;
  margin-top: 16rpx;
  opacity: 1;
  transform: translateY(0);
}

.cluster-panel-body.is-collapsed {
  max-height: 0;
  margin-top: 0;
  opacity: 0;
  transform: translateY(16rpx);
}

.cluster-count {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  color: #0f172a;
  background: #f1f5f9;
  font-size: 26rpx;
  font-weight: 600;
}

.marker-list-scroll {
  width: 100vw;
  margin-left: -32rpx;
  padding-bottom: 24rpx;
  margin-top: 16rpx;
  white-space: nowrap;
}

.marker-list {
  display: inline-flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 8rpx 32rpx;
  gap: 24rpx;
}

.marker-list-item {
  display: flex;
  flex-direction: column;
  width: 580rpx;
  flex-shrink: 0;
  white-space: normal;
  box-sizing: border-box;
  border-radius: 40rpx 35rpx 45rpx 38rpx / 38rpx 45rpx 35rpx 40rpx;
  background: var(--bg-color-content);
  border: 4rpx solid var(--border-color);
  box-shadow: 0 10rpx 0 0 var(--shadow-btn);
  transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), border-color 0.2s ease;
  position: relative;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.marker-list-item.is-selected {
  background: var(--bg-color);
  border-color: var(--focus-yellow);
  box-shadow: 0 14rpx 0 0 var(--focus-yellow-dark), 0 10rpx 20rpx rgba(114, 93, 66, 0.15);
  transform: translateY(-4rpx);
}

.marker-list-item.is-selected.is-selected-fishing {
  border-color: #1a6f8a;
  box-shadow: 0 14rpx 0 0 #114c60, 0 10rpx 20rpx rgba(114, 93, 66, 0.15);
}

.marker-list-item.is-selected.is-selected-discovery {
  border-color: #3b7a57;
  box-shadow: 0 14rpx 0 0 #28563c, 0 10rpx 20rpx rgba(114, 93, 66, 0.15);
}

.marker-list-item.is-selected.is-selected-notice {
  border-color: #a05a2c;
  box-shadow: 0 14rpx 0 0 #7a421e, 0 10rpx 20rpx rgba(114, 93, 66, 0.15);
}

.marker-list-item.is-selected.is-selected-urgent {
  border-color: #bd3a3a;
  box-shadow: 0 14rpx 0 0 #912727, 0 10rpx 20rpx rgba(114, 93, 66, 0.15);
}

.marker-list-item.is-selected.is-selected-lost_found {
  border-color: #63439e;
  box-shadow: 0 14rpx 0 0 #4a3077, 0 10rpx 20rpx rgba(114, 93, 66, 0.15);
}

.marker-list-item.is-selected.is-selected-help {
  border-color: #cc6015;
  box-shadow: 0 14rpx 0 0 #9e460b, 0 10rpx 20rpx rgba(114, 93, 66, 0.15);
}

.marker-list-item.is-selected.is-selected-kindness {
  border-color: #bd3a72;
  box-shadow: 0 14rpx 0 0 #9c2759, 0 10rpx 20rpx rgba(114, 93, 66, 0.15);
}

.list-item-content {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

/* Mask for voting */
.card-mask {
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  background: rgba(248, 248, 240, 0.85);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx 35rpx 45rpx 38rpx / 38rpx 45rpx 35rpx 40rpx;
  border: 4rpx solid var(--border-color);
  animation: fade-in 0.2s ease-out;
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.mask-btn-group {
  display: flex;
  align-items: center;
  gap: 48rpx;
}

.mask-sep {
  width: 4rpx;
  height: 48rpx;
  background: var(--border-color-light);
  border-radius: 999rpx;
}

.mask-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: var(--bg-color-secondary);
  border: 4rpx solid var(--border-color);
  box-shadow: 0 8rpx 0 0 var(--shadow-btn);
  transition: transform 0.1s ease, box-shadow 0.1s ease;
}

.mask-btn:active, .vote-active {
  transform: translateY(6rpx) scale(0.95);
  box-shadow: 0 2rpx 0 0 var(--shadow-btn);
}

.mask-btn.is-active {
  background: var(--warning-color);
  border-color: var(--border-color);
  box-shadow: 0 8rpx 0 0 var(--warning-color-active);
}

.mask-btn.is-active:active, .mask-btn.is-active.vote-active {
  box-shadow: 0 2rpx 0 0 var(--warning-color-active);
}

.mask-icon {
  font-size: 56rpx;
  line-height: 1;
}

.vote-animate {
  animation: vote-pop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}

@keyframes vote-pop {
  0% { transform: scale(1); }
  50% { transform: scale(1.3) translateY(-10rpx); }
  100% { transform: scale(1.1); }
}

.list-item-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
  min-height: 180rpx;
}

.card-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.card-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.card-score-badge {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  color: var(--text-color);
}

.score-label {
  font-size: 22rpx;
  font-weight: 700;
}

.score-num {
  font-size: 32rpx;
  font-weight: 800;
  font-family: Nunito, -apple-system, BlinkMacSystemFont, sans-serif;
  letter-spacing: -0.5rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  border: 2rpx solid var(--border-color);
}

.category-fishing {
  color: #1a6f8a;
  background: #d4f0f7;
}

.category-discovery {
  color: #3b7a57;
  background: #d2edd9;
}

.category-notice {
  color: #a05a2c;
  background: #fae4c3;
}

.category-urgent {
  color: #bd3a3a;
  background: #fcd5d5;
}

.category-lost_found {
  color: #63439e;
  background: #e9e3f7;
}

.category-help {
  color: #cc6015;
  background: #ffe3d1;
}

.category-kindness {
  color: #bd3a72;
  background: #fcd5e5;
}

.mine-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  color: #ffffff;
  background: var(--text-color);
  border: 2rpx solid var(--border-color);
  font-size: 22rpx;
  font-weight: 800;
  box-shadow: 0 2rpx 8rpx rgba(121, 79, 39, 0.2);
}

.card-title {
  display: block;
  margin-top: 16rpx;
  overflow: hidden;
  color: var(--text-color);
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-desc {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--text-color-body);
  font-size: 26rpx;
  line-height: 38rpx;
  white-space: normal;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-image-scroll {
  width: 100%;
  margin-top: 16rpx;
}

.card-image-list {
  display: flex;
  gap: 12rpx;
  width: max-content;
}

.card-image {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  border: 3rpx solid var(--border-color);
  background: var(--bg-color-secondary);
}

.card-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 16rpx;
}

.card-time {
  color: var(--text-color-secondary);
  font-size: 22rpx;
}

.card-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 70rpx;
}

.small-action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  background: var(--bg-color-secondary);
  border: 3rpx solid var(--border-color);
  border-radius: 50%;
  font-size: 28rpx;
  color: var(--text-color-body);
  box-shadow: 0 4rpx 0 0 var(--shadow-btn);
  transition: transform 0.1s ease, box-shadow 0.1s ease;
}

.small-action-icon:active, .small-action-icon.btn-active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 0 0 var(--shadow-btn);
}

.small-action-icon.danger {
  color: #ffffff;
  background: var(--error-color);
  border-color: var(--border-color);
  box-shadow: 0 4rpx 0 0 var(--error-color-active);
}

/* --- 掉落与摇晃物理动画 --- */
.drop-marker-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
  background: transparent;
}

.drop-marker-container {
  position: absolute;
  top: 50%;
  left: 50%;
  /* 调整中心点，使图片底部中心正好对准地图中心 */
  transform: translate(-50%, -100%);
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.drop-marker-icon {
  width: 88rpx;
  height: 88rpx;
  transform-origin: bottom center;
  animation: dropAndWobble 0.5s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
}

.drop-marker-shadow {
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  width: 32rpx;
  height: 8rpx;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 50%;
  transform-origin: center;
  animation: shadowGrow 0.5s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
}

@keyframes dropAndWobble {
  0% { transform: translateY(-600rpx) scale(1, 1); opacity: 0; }
  15% { transform: translateY(-400rpx) scale(0.9, 1.1); opacity: 1; }
  40% { transform: translateY(0) scale(1.2, 0.8); }
  55% { transform: translateY(0) scale(0.95, 1.05) rotate(-12deg); }
  70% { transform: translateY(0) scale(1, 1) rotate(8deg); }
  85% { transform: translateY(0) scale(1, 1) rotate(-4deg); }
  100% { transform: translateY(0) scale(1, 1) rotate(0deg); opacity: 1; }
}

@keyframes shadowGrow {
  0% { transform: translateX(-50%) scale(0); opacity: 0; }
  40% { transform: translateX(-50%) scale(1); opacity: 1; }
  100% { transform: translateX(-50%) scale(1); opacity: 1; }
}

.small-action-icon.danger:active, .small-action-icon.danger.btn-active {
  box-shadow: 0 2rpx 0 0 var(--error-color-active);
}
