<view class="page">
  <view wx:if="{{false}}" class="header">
    <text class="location-status">{{locationLabel}}</text>
    <view class="header-actions">
      <button class="icon-button" bindtap="onSearchTap">搜索</button>
      <button class="icon-button" bindtap="onLocateTap">定位</button>
      <button class="icon-button primary-icon-button" bindtap="onStartSelectLocationTap">新增标记</button>
    </view>
  </view>

  <view wx:if="{{false && showPermissionStrip}}" class="permission-strip">
    <text>浏览模式：可查看和搜索，开启定位后可创建和评价。</text>
    <button class="text-button" bindtap="onOpenSettingTap">开启定位</button>
  </view>

  <view class="map-shell">
    <map
      id="markMap"
      class="map"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="{{scale}}"
      markers="{{mapMarkers}}"
      show-location="{{hasLocationAuth}}"
      bindmarkertap="onMarkerTap"
      bindlabeltap="onMarkerTap"
      bindcallouttap="onMarkerTap"
      bindregionchange="onMapRegionChange"
      bindtap="onMapTap"
    >
      <view class="map-filter">
        <view class="map-filter-icon" catchtap="onMapFilterIconTap">🏷️</view>
        <scroll-view 
          class="map-filter-list {{isMapFilterExpanded ? 'is-expanded' : (activeCategory !== 'all' ? 'is-collapsed-active' : 'is-hidden')}}"
          scroll-x="{{isMapFilterExpanded}}"
          enable-flex="{{true}}"
          show-scrollbar="{{false}}"
        >
          <block wx:for="{{mapFilterCategories}}" wx:key="value">
            <view
              class="map-filter-chip category-chip-{{item.value}} {{item.selectedClass}} {{!isMapFilterExpanded && index > 0 ? 'is-chip-hidden' : ''}}"
              hover-class="chip-active"
              data-category="{{item.value}}"
              catchtap="onMapFilterCategoryTap"
            >{{item.label}}</view>
          </block>
        </scroll-view>
      </view>
      <cover-view class="map-create-button" hover-class="btn-active" catchtap="onCreateMarkerEntryTap">
        <cover-view class="create-icon-halo">
          <cover-view class="create-icon-plus">+</cover-view>
        </cover-view>
      </cover-view>
      <cover-view class="{{mapLocateButtonClass}}" hover-class="btn-active" bindtap="onLocateTap">
        <cover-view class="map-locate-radar">
          <cover-view class="radar-outer-ring">
            <cover-view class="radar-halo">
              <cover-view class="radar-dot"></cover-view>
            </cover-view>
          </cover-view>
        </cover-view>
      </cover-view>
    </map>
  </view>

  <view wx:if="{{panelMode !== 'browse'}}" class="panel">
    <block wx:if="{{panelMode === 'cluster'}}">
      <view
        class="cluster-panel-drag-area"
        bindtouchstart="onClusterPanelBarTouchStart"
        bindtouchend="onClusterPanelBarTouchEnd"
      >
        <view class="drag-pill"></view>
      </view>

      <view class="cluster-panel-body {{clusterPanelStateClass}}">
        <scroll-view wx:if="{{selectedClusterMarkers.length}}" class="marker-list-scroll" scroll-x show-scrollbar="{{false}}" bindscroll="onMarkerListScroll">
          <view class="marker-list">
            <view
              wx:for="{{selectedClusterMarkers}}"
              wx:key="id"
              class="{{item.listItemClass}}"
              data-id="{{item.id}}"
              bindtap="onMarkerListItemTap"
              bindlongpress="onMarkerListItemLongPress"
            >
              <view class="list-item-content">
                <view class="list-item-main">
                  <view class="card-row">
                    <view class="card-tags">
                      <text class="{{item.categoryClass}}">{{item.categoryLabel}}</text>
                      <text wx:if="{{item.isMine}}" class="mine-badge">我</text>
                    </view>
                    <view class="card-score-badge">
                      <text class="score-label">有用</text>
                      <text class="score-num">{{item.displayScore}}</text>
                    </view>
                  </view>
                  <text class="card-title">{{item.displayTitle}}</text>
                  <text class="card-desc">{{item.displayDescription}}</text>
                  <scroll-view wx:if="{{item.images.length}}" class="card-image-scroll" scroll-x show-scrollbar="{{false}}">
                    <view class="card-image-list">
                      <image
                        wx:for="{{item.images}}"
                        wx:key="id"
                        class="card-image"
                        src="{{item.fullUrl}}"
                        mode="aspectFill"
                        data-id="{{item.id}}"
                        data-url="{{item.fullUrl}}"
                        catchtap="onPreviewMarkerImageTap"
                      />
                    </view>
                  </scroll-view>
                  <view class="card-bottom">
                    <text class="card-time">{{item.timeText}}</text>
                    <view class="card-actions">
                      <view wx:if="{{selectedMarkerId === item.id}}" class="small-action-icon" hover-class="btn-active" data-id="{{item.id}}" catchtap="onNavigateMarkerTap">
                        <text>🧭</text>
                      </view>
                      <view wx:if="{{selectedMarkerId === item.id && item.isMine}}" class="small-action-icon danger" hover-class="btn-active" data-id="{{item.id}}" catchtap="onDeleteMarkerTap">
                        <text>🗑</text>
                      </view>
                    </view>
                  </view>
                </view>
              </view>
              
              <!-- Long press mask -->
              <view wx:if="{{longPressedMarkerId === item.id}}" class="card-mask" catchtap="onMaskTap">
                <view class="mask-btn-group">
                  <view class="mask-btn {{item.isLiked ? 'is-active' : ''}} {{animatingVoteValue === 1 ? 'vote-animate' : ''}}" hover-class="vote-active" data-id="{{item.id}}" data-vote="1" catchtap="onVoteTap">
                    <text class="mask-icon">👍</text>
                  </view>
                  <view class="mask-sep"></view>
                  <view class="mask-btn {{item.isDisliked ? 'is-active' : ''}} {{animatingVoteValue === -1 ? 'vote-animate' : ''}}" hover-class="vote-active" data-id="{{item.id}}" data-vote="-1" catchtap="onVoteTap">
                    <text class="mask-icon">👎</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>


      </view>
    </block>

    <block wx:else>
      <view class="panel-head">
        <view>
          <text class="panel-title">{{browseTitle}}</text>
          <text class="panel-subtitle">{{browseSubtitle}}</text>
        </view>
      </view>
    </block>
  </view>
</view>
