<view class="page">
  <view class="header">
    <text class="location-status">{{locationLabel}}</text>
    <view class="header-actions">
      <button class="icon-button" bindtap="onSearchTap">搜索</button>
      <button class="icon-button" bindtap="onLocateTap">定位</button>
      <button class="icon-button primary-icon-button" bindtap="onStartSelectLocationTap">新增标记</button>
    </view>
  </view>

  <scroll-view wx:if="{{showCategoryBar}}" class="category-scroll" scroll-x show-scrollbar="{{false}}">
    <view class="category-list">
      <view
        wx:for="{{filterCategories}}"
        wx:key="value"
        class="category-chip {{item.activeClass}}"
        data-category="{{item.value}}"
        bindtap="onCategoryTap"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{showPermissionStrip}}" class="permission-strip">
    <text>浏览模式：可查看和搜索，开启定位后可创建和评价。</text>
    <button class="text-button" bindtap="onOpenSettingTap">开启定位</button>
  </view>

  <view class="map-shell">
    <map
      id="markMap"
      class="map"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="{{scale}}"
      markers="{{mapMarkers}}"
      show-location="{{hasLocationAuth}}"
      bindmarkertap="onMarkerTap"
      bindlabeltap="onMarkerTap"
      bindtap="onMapTap"
    />
  </view>

  <view class="panel">
    <block wx:if="{{panelMode === 'form'}}">
      <view class="panel-head">
        <view>
          <text class="panel-title">创建标记</text>
          <text class="panel-subtitle">{{pendingPoint.name}} · {{pendingPoint.latitudeText}}, {{pendingPoint.longitudeText}}</text>
        </view>
      </view>
      <view class="form-section">
        <view class="field-label">分类</view>
        <view class="form-category-list">
          <view
            wx:for="{{markCategories}}"
            wx:key="value"
            class="form-category {{item.selectedClass}}"
            data-category="{{item.value}}"
            bindtap="onFormCategoryTap"
          >
            {{item.label}}
          </view>
        </view>
        <view class="field-label">标题</view>
        <input class="text-input" value="{{form.title}}" maxlength="24" placeholder="可不填" bindinput="onTitleInput" />
        <view class="field-label">描述</view>
        <textarea class="textarea-input" value="{{form.description}}" maxlength="120" placeholder="可不填" bindinput="onDescriptionInput" />
      </view>
      <view class="panel-actions">
        <button class="secondary-button" bindtap="onCancelCreateTap">取消</button>
        <button class="primary-button" bindtap="onSaveMarkerTap">保存标记</button>
      </view>
    </block>

    <block wx:elif="{{panelMode === 'cluster'}}">
      <view class="panel-head">
        <view>
          <text wx:if="{{selectedClusterMarkers.length === 1}}" class="panel-title">标记详情</text>
          <text wx:else class="panel-title">区域标记</text>
          <text wx:if="{{selectedClusterMarkers.length === 1 && selectedMarker}}" class="panel-subtitle">{{selectedMarker.categoryLabel}} · 分 {{selectedMarker.displayScore}} · {{selectedMarker.timeText}}</text>
          <text wx:else class="panel-subtitle">{{selectedClusterMarkers.length}} 条标记，点击列表查看详情</text>
        </view>
        <text class="cluster-count">{{activeCategoryLabel}}</text>
      </view>

      <scroll-view wx:if="{{selectedClusterMarkers.length > 1}}" class="marker-list-scroll" scroll-y show-scrollbar="{{false}}">
        <view class="marker-list">
          <view
            wx:for="{{selectedClusterMarkers}}"
            wx:key="id"
            class="{{item.listItemClass}}"
            data-id="{{item.id}}"
            bindtap="onMarkerListItemTap"
          >
            <view class="list-item-main">
              <view class="card-row">
                <text class="{{item.categoryClass}}">{{item.categoryLabel}}</text>
                <text wx:if="{{item.isMine}}" class="mine-badge">我</text>
              </view>
              <text class="card-title">{{item.displayTitle}}</text>
              <text class="card-desc">{{item.displayDescription}}</text>
              <view class="card-meta">
                <text>分 {{item.displayScore}}</text>
                <text>{{item.timeText}}</text>
              </view>
            </view>
            <text class="list-item-arrow">›</text>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{selectedMarker}}" class="detail">
        <view class="detail-main">
          <text class="detail-title">{{selectedMarker.displayTitle}}</text>
          <text class="detail-desc">{{selectedMarker.displayDescription}}</text>
          <view class="detail-meta">
            <text>{{selectedMarker.categoryLabel}}</text>
            <text>分 {{selectedMarker.displayScore}}</text>
            <text>{{selectedMarker.timeText}}</text>
          </view>
        </view>
        <view class="detail-actions">
          <button class="{{selectedMarker.likeButtonClass}}" data-vote="1" catchtap="onVoteTap">赞</button>
          <button class="{{selectedMarker.dislikeButtonClass}}" data-vote="-1" catchtap="onVoteTap">踩</button>
          <button wx:if="{{selectedMarker.isMine}}" class="danger-button" catchtap="onDeleteMarkerTap">删除</button>
          <button wx:else class="secondary-button compact" catchtap="onReportTap">举报</button>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="panel-head">
        <view>
          <text class="panel-title">{{browseTitle}}</text>
          <text class="panel-subtitle">{{browseSubtitle}}</text>
        </view>
      </view>
    </block>
  </view>
</view>
