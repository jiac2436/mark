page {
  min-height: 100vh;
  background: var(--bg-color);
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.section {
  margin-bottom: 36rpx;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  color: var(--text-color);
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 800;
}

.feedback-input {
  width: 100%;
  height: 360rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: var(--bg-color-content);
  color: var(--text-color-body);
  font-size: 28rpx;
  line-height: 42rpx;
  border: 4rpx solid var(--border-color);
  box-shadow: inset 0 6rpx 0 0 var(--shadow-input);
}

.feedback-input.is-focused {
  border-color: var(--focus-yellow);
  box-shadow: inset 0 6rpx 0 0 var(--focus-yellow-dark), 0 0 0 6rpx rgba(255, 204, 0, 0.15);
}

.input-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 14rpx;
}

.input-hint,
.input-count {
  color: var(--text-color-secondary);
  font-size: 24rpx;
  line-height: 32rpx;
}

.input-hint {
  flex: 1;
  min-width: 0;
}

.input-count {
  flex-shrink: 0;
}

.footer {
  margin-top: 52rpx;
}

.submit-button {
  width: 100%;
  height: 92rpx;
  font-size: 30rpx;
}
