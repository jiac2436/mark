<view class="page">
  <view class="section">
    <text class="section-title">反馈内容</text>
    <textarea
      class="feedback-input {{isFocused ? 'is-focused' : ''}}"
      value="{{content}}"
      maxlength="500"
      placeholder="请写下你遇到的问题或建议，5-500个字"
      show-confirm-bar="{{false}}"
      bindinput="onContentInput"
      bindfocus="onContentFocus"
      bindblur="onContentBlur"
    />
    <view class="input-meta">
      <text class="input-hint">匿名提交，不需要填写联系方式</text>
      <text class="input-count">{{contentLength}}/500</text>
    </view>
  </view>

  <view class="footer">
    <button class="btn-3d btn-3d-primary submit-button" hover-class="btn-active" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="onSubmitTap">提交反馈</button>
  </view>
</view>
