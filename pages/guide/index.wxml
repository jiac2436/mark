<scroll-view class="page" scroll-y enhanced show-scrollbar="{{false}}">

  <!-- 标题区 -->
  <view class="hero">
    <text class="hero-title">地图 Mark</text>
    <text class="hero-tagline">在地图上随手记录，分享给每一个路过的人</text>
  </view>

  <!-- 这是什么 -->
  <view class="card">
    <view class="card-header">
      <text class="card-icon">📋</text>
      <text class="card-title">这是什么</text>
    </view>
    <text class="card-text">「地图 Mark」是一款公共地图笔记工具。你可以在地图上的任意位置创建标记，记录发现、提醒或求助信息。所有标记公开可见，帮助附近的人获取有用信息。</text>
  </view>

  <!-- 图标说明 -->
  <view class="card">
    <view class="card-header">
      <text class="card-icon">🏷️</text>
      <text class="card-title">标记分类</text>
    </view>
    <text class="card-text">每条标记都属于一种分类，在地图上用不同的图标表示：</text>
    <view class="icon-grid">
      <view wx:for="{{categories}}" wx:key="label" class="icon-item">
        <image class="icon-image" src="{{item.iconPath}}" mode="aspectFit" />
        <view class="icon-info">
          <text class="icon-label">{{item.label}}</text>
          <text class="icon-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 地图上的按钮 -->
  <view class="card">
    <view class="card-header">
      <text class="card-icon">🗺️</text>
      <text class="card-title">地图上的按钮</text>
    </view>
    <view class="button-explain-list">
      <view class="button-explain-item">
        <view class="explain-icon-box">
          <text class="explain-icon-text">🏷️</text>
        </view>
        <view class="explain-content">
          <text class="explain-label">筛选</text>
          <text class="explain-desc">展开分类列表，按类型筛选地图上的标记</text>
        </view>
      </view>
      <view class="button-explain-item">
        <view class="explain-icon-box">
          <text class="explain-icon-text explain-plus">+</text>
        </view>
        <view class="explain-content">
          <text class="explain-label">新增标记</text>
          <text class="explain-desc">选择位置并创建一条新的标记</text>
        </view>
      </view>
      <view class="button-explain-item">
        <view class="explain-icon-box">
          <text class="explain-icon-text explain-locate">◎</text>
        </view>
        <view class="explain-content">
          <text class="explain-label">定位</text>
          <text class="explain-desc">回到当前位置</text>
        </view>
      </view>
      <view class="button-explain-item">
        <view class="explain-icon-box">
          <text class="explain-icon-text">?</text>
        </view>
        <view class="explain-content">
          <text class="explain-label">使用说明</text>
          <text class="explain-desc">打开本页面</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 如何新增标记 -->
  <view class="card">
    <view class="card-header">
      <text class="card-icon">📌</text>
      <text class="card-title">如何新增标记</text>
    </view>
    <view class="step-list">
      <view class="step-item">
        <text class="step-num">1</text>
        <text class="step-text">点击地图左侧的 ＋ 按钮</text>
      </view>
      <view class="step-item">
        <text class="step-num">2</text>
        <text class="step-text">在弹出的微信地图中选择标记位置</text>
      </view>
      <view class="step-item">
        <text class="step-num">3</text>
        <text class="step-text">选择一个标签分类（必选）</text>
      </view>
      <view class="step-item">
        <text class="step-num">4</text>
        <text class="step-text">填写标题和描述（可不填，留空会显示默认文案）</text>
      </view>
      <view class="step-item">
        <text class="step-num">5</text>
        <text class="step-text">可上传最多 5 张实景照片</text>
      </view>
      <view class="step-item">
        <text class="step-num">6</text>
        <text class="step-text">点击「确认」提交</text>
      </view>
    </view>
  </view>

  <!-- 如何评价标记 -->
  <view class="card">
    <view class="card-header">
      <text class="card-icon">👍</text>
      <text class="card-title">如何评价标记</text>
    </view>
    <text class="card-text">评价帮助优质标记被更多人看到。</text>
    <view class="step-list">
      <view class="step-item">
        <text class="step-num">1</text>
        <text class="step-text">点击地图上的标记点，打开标记卡片</text>
      </view>
      <view class="step-item">
        <text class="step-num">2</text>
        <text class="step-text">长按标记卡片，弹出评价面板</text>
      </view>
      <view class="step-item">
        <text class="step-num">3</text>
        <text class="step-text">点击 👍 点赞或 👎 点踩</text>
      </view>
    </view>
    <view class="note-box">
      <text class="note-text">每条标记只能赞或踩一次，再次点击可取消。对外仅展示综合分。</text>
    </view>
  </view>

  <!-- 如何删除标记 -->
  <view class="card">
    <view class="card-header">
      <text class="card-icon">🗑️</text>
      <text class="card-title">如何删除标记</text>
    </view>
    <text class="card-text">你创建的标记会带有「我」徽标，其他人看不到作者信息。</text>
    <view class="step-list">
      <view class="step-item">
        <text class="step-num">1</text>
        <text class="step-text">在标记列表中找到带「我」标识的标记</text>
      </view>
      <view class="step-item">
        <text class="step-num">2</text>
        <text class="step-text">点击选中该标记</text>
      </view>
      <view class="step-item">
        <text class="step-num">3</text>
        <text class="step-text">点击卡片右下角的 🗑️ 按钮</text>
      </view>
    </view>
  </view>

  <!-- 其他功能 -->
  <view class="card">
    <view class="card-header">
      <text class="card-icon">🧭</text>
      <text class="card-title">其他功能</text>
    </view>
    <view class="feature-list">
      <view class="feature-item">
        <text class="feature-dot">•</text>
        <view class="feature-content">
          <text class="feature-label">导航前往</text>
          <text class="feature-desc">选中标记后点击 🧭 图标，可打开微信地图查看路线。</text>
        </view>
      </view>
      <view class="feature-item">
        <text class="feature-dot">•</text>
        <view class="feature-content">
          <text class="feature-label">搜索位置</text>
          <text class="feature-desc">使用搜索功能可快速定位到任意地点，查看周边标记。</text>
        </view>
      </view>
      <view class="feature-item">
        <text class="feature-dot">•</text>
        <view class="feature-content">
          <text class="feature-label">标记聚合</text>
          <text class="feature-desc">同一区域的多条标记会自动聚合为一个点，点击可展开查看全部。</text>
        </view>
      </view>
      <view class="feature-item">
        <text class="feature-dot">•</text>
        <view class="feature-content">
          <text class="feature-label">举报</text>
          <text class="feature-desc">发现不当内容可通过标记详情进行举报。</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 关于定位 -->
  <view class="card">
    <view class="card-header">
      <text class="card-icon">📍</text>
      <text class="card-title">关于定位</text>
    </view>
    <text class="card-text">地图 Mark 需要获取你的位置信息用于定位和创建标记。</text>
    <view class="note-box">
      <text class="note-text">• 授权定位后可浏览、创建、评价标记</text>
      <text class="note-text">• 未授权时进入浏览模式，可查看和搜索，但无法创建和评价</text>
      <text class="note-text">• 可随时在小程序设置中开启或关闭定位权限</text>
    </view>
  </view>

  <!-- 底部 -->
  <view class="footer">
    <button class="btn-3d btn-3d-primary back-button" hover-class="btn-active" bindtap="onBackTap">我知道了</button>
  </view>

</scroll-view>
