page {
  height: 100%;
  /* 动森色彩系统 */
  --primary-color: #19c8b9;
  --primary-color-hover: #3dd4c6;
  --primary-color-active: #11a89b;
  --primary-color-bg: #e6f9f6;

  /* 文字 */
  --text-color: #794f27;
  --text-color-body: #725d42;
  --text-color-secondary: #9f927d;
  --text-color-muted: #8a7b66;
  --text-color-disabled: #c4b89e;

  /* 边框与背景 */
  --border-color: #9f927d;
  --border-color-light: #c4b89e;
  --bg-color: #f8f8f0;
  --bg-color-content: rgb(247, 243, 223);
  --bg-color-secondary: #f0e8d8;
  --bg-color-disabled: #f0ece2;
  --bg-color-input: rgb(247, 243, 223);

  /* 状态色 */
  --success-color: #6fba2c;
  --success-color-active: #5a9e1e;
  --warning-color: #f5c31c;
  --warning-color-active: #dba90e;
  --error-color: #e05a5a;
  --error-color-active: #c94444;

  /* 游戏特殊色 */
  --focus-yellow: #ffcc00;
  --focus-yellow-dark: #e0b800;

  /* 3D 阴影色 */
  --shadow-btn: #bdaea0;
  --shadow-input: #d4c9b4;

  color: var(--text-color-body);
  background: var(--bg-color);
  font-family: Nunito, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans SC", "Zen Maru Gothic", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-sizing: border-box;
}

button::after {
  border: 0;
}

/* 全局 3D 按钮组件规范 */
.btn-3d {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  letter-spacing: 0.02em;
  border: 4rpx solid var(--border-color);
  border-radius: 100rpx; /* pill shape */
  transition: transform 0.1s ease, box-shadow 0.1s ease;
  box-sizing: border-box;
  text-shadow: 0 1rpx 1rpx rgba(255, 255, 255, 0.5);
}

/* 按钮点击/长按的下压反馈 */
.btn-active, .btn-3d:active {
  transform: translateY(8rpx) !important;
}

/* 主按钮：薄荷绿底，深棕字 */
.btn-3d-primary {
  color: var(--text-color);
  background: var(--primary-color-bg);
  box-shadow: 0 10rpx 0 0 var(--shadow-btn);
}
.btn-3d-primary.btn-active, .btn-3d-primary:active {
  box-shadow: 0 2rpx 0 0 var(--shadow-btn) !important;
}

/* 次按钮：奶油白底，棕字 */
.btn-3d-secondary {
  color: var(--text-color-body);
  background: var(--bg-color);
  box-shadow: 0 10rpx 0 0 var(--shadow-btn);
}
.btn-3d-secondary.btn-active, .btn-3d-secondary:active {
  box-shadow: 0 2rpx 0 0 var(--shadow-btn) !important;
}

/* 警示/删除按钮 */
.btn-3d-danger {
  color: #ffffff;
  background: var(--error-color);
  border-color: var(--border-color);
  box-shadow: 0 10rpx 0 0 var(--error-color-active);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
}
.btn-3d-danger.btn-active, .btn-3d-danger:active {
  box-shadow: 0 2rpx 0 0 var(--error-color-active) !important;
}

/* 禁用状态 */
.btn-3d-disabled {
  opacity: 0.5;
  pointer-events: none;
}
